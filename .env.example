# Variables usadas por docker-compose.yaml (no por los servicios individuales,
# que tienen su propio .env en backend/, agente/).
# Copiar a .env en esta misma carpeta y completar antes de correr `docker compose up`.

# URL pública real del backend cuando se despliega fuera de localhost.
# Si no se define, se usa http://localhost:4000 (solo válido para correr todo en la misma máquina).
# VITE_API_URL=https://mi-servidor.com:4000

# Modelo de OpenRouter a usar por el agente (debe soportar tool calling). La clave
# OPENROUTER_API_KEY va en agente/.env.
# OPENROUTER_MODEL=openai/gpt-4o-mini
