# En Docker el compose define BACKEND_URL; este valor es para correr en local (npm run dev).
BACKEND_URL=http://localhost:3000
OPENROUTER_API_KEY=tu_api_key_de_openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
# URL pública de la página web (el bot la menciona al pedir que vinculen la cuenta)
WEB_URL=http://localhost:5173
# Solo para el modo CLI: token obtenido al iniciar sesión en la web
INVENTARIO_TOKEN=
TELEGRAM_TOKEN=tu_token_de_botfather
MODE=telegram
PORT=5000
FORCE_HTTPS=false
# Emisor esperado en los tokens del backend (debe coincidir con JWT_ISSUER del backend)
JWT_ISSUER=inventario-backend
