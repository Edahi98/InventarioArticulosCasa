# En Docker el compose define BACKEND_URL; este valor es para correr en local (npm run dev).
BACKEND_URL=http://localhost:3000
OPENROUTER_API_KEY=tu_api_key_de_openrouter
# Sin valor por defecto: si no lo declaras, el agente usa llama.cpp
OPENROUTER_MODEL=openai/gpt-4o-mini
# Proveedor del modelo del agente: openrouter (nube) o llama (llama.cpp local; requiere uv sync --extra local)
# Si no lo declaras: openrouter cuando OPENROUTER_MODEL tiene valor, llama si no
# El filtro de instrucciones (DECISIONS_MODEL) sigue usando OPENROUTER_API_KEY con cualquiera de los dos
LLM_PROVIDER=openrouter
# Solo con LLM_PROVIDER=llama: ruta del modelo .gguf, contexto y capas en GPU (0 = solo CPU)
LLAMA_MODEL_PATH=
LLAMA_CONTEXT=8192
LLAMA_GPU_LAYERS=0
# Modelo de la API de decisions de OpenRouter que filtra los mensajes que no son de inventario
DECISIONS_MODEL=typesafe/jev-1.13
# URL pública de la página web (el bot la menciona al pedir que vinculen la cuenta)
WEB_URL=http://localhost:5173
# Solo para el modo CLI: token obtenido al iniciar sesión en la web
INVENTARIO_TOKEN=
TELEGRAM_TOKEN=tu_token_de_botfather
MODE=telegram
PORT=5000
FORCE_HTTPS=false
# Emisor esperado en los tokens del backend (debe coincidir con JWT_ISSUER del backend)
JWT_ISSUER=inventario-backend
# Solo Vercel: Postgres del pooler de Supabase (aws-0-<región>.pooler.supabase.com:6543) para el estado de la conversación
STATE_DATABASE_URL=
# Solo Vercel: secreto del webhook de Telegram (cualquier cadena larga y aleatoria)
TELEGRAM_WEBHOOK_SECRET=
