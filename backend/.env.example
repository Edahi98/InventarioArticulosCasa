PORT=3000

# ENGINE=local  -> Supabase (PostgreSQL)
# ENGINE=cloud  -> Turso (libSQL) [default]
ENGINE=cloud

# Turso (cloud)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# Supabase (local) -- Connection Pooling URL de Supabase dashboard -> Settings -> Database
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

JWT_SECRET=your-jwt-secret

# STORAGE=cloudinary  -> Cloudinary [default]
# STORAGE=ftp          -> servidor FTP propio (ver docker-compose.yaml)
STORAGE=cloudinary

CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Solo si STORAGE=ftp
FTP_HOST=localhost
FTP_PORT=21
FTP_USER=user
FTP_PASS=user
FTP_FOLDER=/
# Ruta local donde se montan los archivos del FTP para servirlos como estáticos en /files
FTP_LOCAL_PATH=./ftpfiles
# URL pública base desde la que el backend sirve /files (usada para construir las URLs devueltas)
PUBLIC_URL=http://localhost:3000
