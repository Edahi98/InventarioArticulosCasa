PORT=3000

# Supabase (PostgreSQL) -- Connection Pooling URL de Supabase dashboard -> Settings -> Database
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave privada RSA. Genera una con: npm run keys:generate y pega la línea que imprime CON las comillas
# dobles (sin ellas, dotenv corta el valor en el primer salto de línea)
# Solo el backend la tiene; el agente verifica con la clave pública que publica en /.well-known/jwks.json
JWT_PRIVATE_KEY=
# Emisor que se escribe en los tokens (el agente debe usar el mismo valor)
JWT_ISSUER=inventario-backend

# Cloudinary (almacenamiento de imágenes): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your-key:your-secret@your-cloud

# Usuario del bot de Telegram (sin @); la web lo usa para ofrecer el enlace de vinculación
TELEGRAM_BOT_USERNAME=

# Saltos de proxy de confianza para la IP del cliente (Vercel lo fija en 1 solo). 0 si no hay proxy.
TRUST_PROXY=0
