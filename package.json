{
  "name": "inventario-articulos-casa",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "frontend",
    "backend",
    "agente"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate -w inventario-backend",
    "db:migrate": "npm run db:migrate -w inventario-backend",
    "db:push": "npm run db:push -w inventario-backend",
    "user:create": "npm run user:create -w inventario-backend --",
    "docker:up": "node scripts/docker.mjs up",
    "docker:down": "node scripts/docker.mjs down",
    "docker:clean": "node scripts/docker.mjs clean",
    "docker:rebuild": "node scripts/docker.mjs rebuild"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
